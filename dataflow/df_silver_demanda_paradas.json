{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "silverDemandaParadas"
				}
			],
			"transformations": [
				{
					"name": "convertirTipos"
				},
				{
					"name": "normalizarIds"
				},
				{
					"name": "generarDemandaId"
				},
				{
					"name": "numerarDuplicados"
				},
				{
					"name": "filtrarUnico"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = iif(isNull(FechaServicio)||trim(FechaServicio)=='', toDate(null()), iif(instr(FechaServicio,'/')>0, toDate(trim(FechaServicio),'dd/MM/yyyy'), iif(instr(FechaServicio,'-')>0, toDate(substring(trim(FechaServicio),1,10),'yyyy-MM-dd'), addDays(toDate('1899-12-30','yyyy-MM-dd'), toInteger(trim(FechaServicio)))))),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          Descensos = toInteger(trim(Descensos)),",
				"          DemandaNoAtendida = toInteger(trim(DemandaNoAtendida)),",
				"          Franja = trim(Franja),",
				"          Metodo = upper(trim(Metodo))) ~> convertirTipos",
				"convertirTipos derive(RutaHistoricaId = iif(upper(trim(RutaHistoricaId))=='R12-N'||upper(trim(RutaHistoricaId))=='RH-12-N','RH-12-N',iif(upper(trim(RutaHistoricaId))=='R12-S'||upper(trim(RutaHistoricaId))=='RH-12-S','RH-12-S',iif(left(upper(trim(RutaHistoricaId)),3)=='RH-',upper(trim(RutaHistoricaId)),iif(lpad(regexReplace(trim(RutaHistoricaId),'[^0-9]',''),2,'0')=='12','RH-12-OLD',iif(lpad(regexReplace(trim(RutaHistoricaId),'[^0-9]',''),2,'0')=='07',iif(FechaServicio>=toDate('2024-01-01','yyyy-MM-dd'),'RH-07-NEW','RH-07'),concat('RH-',lpad(regexReplace(trim(RutaHistoricaId),'[^0-9]',''),2,'0'))))))),",
				"          ParadaHistoricaId = iif(upper(trim(ParadaHistoricaId))=='MC-01', iif(FechaServicio<toDate('2023-07-01','yyyy-MM-dd'),'P220-MC-OLD','P220-MC-NEW'), upper(trim(ParadaHistoricaId)))) ~> normalizarIds",
				"normalizarIds derive(DemandaId = iif(isNull(DemandaId)||trim(DemandaId)=='', concat('DM-', toString(year(FechaServicio)), '-', upper(substring(md5(concat(toString(FechaServicio,'yyyyMMdd'),'|',RutaHistoricaId,'|',ParadaHistoricaId,'|',Franja)),1,10))), upper(trim(DemandaId)))) ~> generarDemandaId",
				"generarDemandaId window(over(DemandaId),",
				"     asc(AnioFuente, true),",
				"     rn = rowNumber()) ~> numerarDuplicados",
				"numerarDuplicados filter(rn == 1) ~> filtrarUnico",
				"filtrarUnico sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> silverDemandaParadas"
			]
		}
	}
}